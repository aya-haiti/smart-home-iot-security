  {
    "id": "980ee094ae1b40c1",
    "type": "function",
    "name": "Anti-flood detector",
    "func": "// Maintient un compteur glissant par topic et alerte en cas de flood\n// Seuil : plus de 30 messages dans les 60 dernieres secondes\nconst SEUIL = 30;\nconst FENETRE_MS = 60000;\n\nlet history = context.get('history') || {};\nconst topic = msg.topic;\nconst now = Date.now();\n\nif (!history[topic]) history[topic] = [];\nhistory[topic].push(now);\n// Nettoyer les vieux timestamps\nhistory[topic] = history[topic].filter(t => now - t < FENETRE_MS);\n\nconst count = history[topic].length;\ncontext.set('history', history);\n\n// Sortie 1 : alerte (uniquement si seuil depasse)\nlet alertMsg = null;\nif (count > SEUIL) {\n    alertMsg = {\n        payload: `ANOMALIE : ${count} msg/min sur ${topic}`,\n        topic: topic\n    };\n}\n\n// Sortie 2 : graphique (rate par topic)\nconst chartMsg = {\n    payload: count,\n    topic: topic\n};\n\nreturn [alertMsg, chartMsg];\n",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 740,
    "wires": [
      [
        "97ab1e95374f21b9"
      ],
      [
        "73a46a13cac3a4a0"
      ]
    ]
  },
